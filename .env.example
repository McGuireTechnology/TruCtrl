# Production Environment Variables for Digital Ocean
# Copy this file to .env and customize for your deployment

# Database Configuration
DATABASE_URL=sqlite:///app/data/tructrl.db

# Application Settings
PYTHONPATH=/app
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# CORS Origins (Update with your frontend URL)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-app.ondigitalocean.app

# Security Settings (Generate secure values for production)
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: External Database (PostgreSQL recommended for production)
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional: Redis for caching/sessions
# REDIS_URL=redis://localhost:6379/0
